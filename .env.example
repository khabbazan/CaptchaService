# Copy to .env and fill in. Never commit .env.
PORT=8002

# Absolute path on the host where the models are stored (mounted at /models). They are downloaded once and reused.
MODELS_DIR=/srv/captcha-models

# Hugging Face READ token. Needed while arkhabbazan/ocr-digits-captcha / ocr-math-captcha are private.
HF_TOKEN=

# OPTIONAL. If set, callers must send it as `Authorization: Bearer <token>` (or `X-API-Token: <token>`); anything else gets 403.
# If empty, no token is checked.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Override the models if you publish new versions elsewhere.
# MATH_MODEL_ID=arkhabbazan/ocr-math-captcha
# DIGITS_MODEL_ID=arkhabbazan/ocr-digits-captcha

# Set to 1 once the models are in the volume, so starting never contacts Hugging Face.
# HF_HUB_OFFLINE=1
